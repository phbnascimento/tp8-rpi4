# =====================================================================
#  Fragmento de kernel para Docker — aplicado sobre o bcm2711_defconfig
# =====================================================================
#  Por quê: o container NÃO tem kernel próprio, ele usa o kernel da Pi.
#  Se faltar recurso aqui, o dockerd não sobe ou o "-p 5000:5000" falha.
#  O bcm2711_defconfig já traz quase tudo; este arquivo só garante que nada
#  essencial fique de fora.
#
#  ATENÇÃO — "=y" aqui é um PEDIDO, não uma garantia: o kconfig rebaixa em
#  silêncio a opção para "=m" quando uma dependência dela é módulo. É o que
#  acontece com CONFIG_BRIDGE: ele tem "depends on IPV6 || IPV6=n" e o
#  bcm2711_defconfig traz CONFIG_IPV6=m, então BRIDGE (e, por consequência,
#  BRIDGE_NETFILTER) sai como módulo mesmo pedindo "=y" abaixo.
#  Isso é seguro neste TP: o alvo tem kmod (/sbin/modprobe), o depmod roda no
#  build e liblzma está no rootfs, então o dockerd carrega bridge.ko.xz e
#  br_netfilter.ko.xz sob demanda. O check-config.sh do Docker aceita "as
#  module". Para forçar built-in seria preciso CONFIG_IPV6=y, o que não vale
#  a pena só por isso.
#
#  Validação: o script 04 roda o check-config.sh do Docker contra o .config
#  gerado (evidence/build/kernel-check-config.txt). Na Pi: docker info
#  (avisos "WARNING: No ... support").
# =====================================================================

# --- Namespaces (isolamento de processos, rede, hostname, IPC) --------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# --- Control groups (limites de CPU/memória/processos) ----------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
# cgroup v2: o controle de dispositivos do runc usa eBPF
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# --- Recursos gerais de container ------------------------------------
CONFIG_KEYS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- Rede: veth + bridge (docker0) -----------------------------------
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y

# --- Netfilter / NAT (publicação de porta -p 5000:5000) ---------------
# iptables do Buildroot é "legacy" (xtables), então usamos IP_NF_*.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_RAW=y
# Docker 28 também cria cadeias IPv6; sem isto o dockerd só gera avisos
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_RAW=y

# --- Armazenamento: driver overlay2 ----------------------------------
CONFIG_OVERLAY_FS=y
