# =====================================================================
#  Opções Buildroot do TP aplicadas POR CIMA da raspberrypi4_64_defconfig
# =====================================================================
#  Quem aplica: scripts/02-configure.sh (merge_config + olddefconfig)
#  Resultado versionado: br2-external/configs/tp_rpi4_defconfig
#
#  Hostname e senha do root NÃO ficam aqui: vêm do tp.env e são gerados
#  em identidade.fragment pelo próprio 02-configure.sh.
#
#  Onde cada opção aparece no "make menuconfig" está comentado ao lado.
# =====================================================================

# --- System configuration ---------------------------------------------
# System configuration → Root filesystem overlay directories
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_TP_PATH)/board/tp/rpi4/rootfs-overlay"
# System configuration → Path to the users tables
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_TP_PATH)/board/tp/rpi4/users_table.txt"
# System configuration → Network interface to configure through DHCP
# Já vem eth0 na defconfig da Pi. É esta opção que gera /etc/network/interfaces
# (com "wait-delay 15", que espera o link subir antes do udhcpc). O checklist do
# TP exige o arquivo também no overlay, e o overlay é copiado DEPOIS dos pacotes:
# por isso a cópia do overlay repete as quatro diretivas na íntegra. Simplificar
# aquele arquivo faria a eth0 voltar a poder ficar sem IP no boot.
BR2_SYSTEM_DHCP="eth0"

# --- Target packages → System tools -----------------------------------
# docker-engine: dockerd + containerd + runc + iptables + S60dockerd
BR2_PACKAGE_DOCKER_ENGINE=y
# docker-cli: o comando "docker" (load, run, ps, images...)
BR2_PACKAGE_DOCKER_CLI=y

# --- Target packages → Libraries → Networking → libcurl → curl binary --
# Os testes do guia usam "curl http://127.0.0.1:5000" na própria Pi.
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y

# --- Filesystem images → ext2/3/4 root filesystem → exact size --------
# A defconfig da Pi usa 120M: não cabe Docker + flask-tp.tar + camadas
# extraídas em /var/lib/docker. Guia da Aula 9: 1024M (2048M se faltar).
BR2_TARGET_ROOTFS_EXT2_SIZE="1024M"

# --- Kernel → Additional configuration fragment files ------------------
# Garante namespaces, cgroups, veth, bridge, netfilter/NAT e overlayfs.
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_TP_PATH)/board/tp/rpi4/linux-docker.fragment"

# --- Target packages → Pacotes do TP ----------------------------------
# Driver do HC-SR04. Compilado como módulo externo contra o kernel deste
# projeto, pela infraestrutura kernel-module do Buildroot.
BR2_PACKAGE_HCSR04_DRIVER=y

# --- Bootloaders → rpi-firmware → config.txt --------------------------
# Nosso config.txt: é a cópia de board/raspberrypi4-64/config_4_64bit.txt
# (64 bits, kernel=Image, arm_64bit=1) acrescida de "dtoverlay=hcsr04".
# Cuidado: o guia manda copiar config_4.txt, que é a variante de 32 bits e
# não dá boot nesta configuração.
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_TP_PATH)/board/tp/rpi4/config_tp.txt"

# --- System configuration → Custom scripts to run after creating images -
# O primeiro script copia hcsr04.dtbo para overlays/ da partição de boot; o
# segundo é o da própria Raspberry, que chama o genimage e monta a imagem.
# A ordem é essencial: o genimage varre images/rpi-firmware/ quando roda.
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_TP_PATH)/board/tp/rpi4/post-image.sh board/raspberrypi4-64/post-image.sh"
