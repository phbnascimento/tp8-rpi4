#!/bin/sh
#
# S99tp-app — sobe o container do dashboard no boot.
#
# Quem executa: o init do BusyBox (/etc/init.d/rcS) roda os scripts Sxx em
# ordem alfabética com "start". S60dockerd (instalado pelo pacote
# docker-engine) inicia o dockerd antes; este S99 espera o daemon responder,
# carrega a imagem do tar embutido no rootfs (só no 1º boot — depois ela fica
# em /var/lib/docker) e cria/inicia o container.
#
# Duas coisas que o container precisa e que o TP cobra: o --device, que é o que
# leva o /dev/hcsr04 para dentro dele (sem isso a API só sabe responder erro),
# e a publicação em 80, para o cliente abrir http://192.168.50.1 sem porta.
#
# Antes de subir, espera as duas condições reais de que depende: o dockerd
# respondendo e o device existindo. Confiar só na ordem dos números dos scripts
# deixaria o boot frágil.

IMAGE="tp-distance:1.0"
CONTAINER="tp-distance"
TAR="/opt/docker/tp-distance.tar"
DEVICE="/dev/hcsr04"
PORTA=80
# 300 tentativas de 0,2 s = 60 s. É a espera que mais pesa no tempo total: o
# dockerd fica pronto num instante qualquer, e sondar de segundo em segundo
# arredonda isso para cima.
TENTATIVAS=300
INTERVALO=0.2

start_app() {
	# Se o device não existe, o container sobe ASSIM MESMO, sem o --device.
	#
	# A tentação é recusar: container sem sensor não mede nada. Mas recusar
	# troca uma falha parcial por um apagão total — sem container não há
	# dashboard, não há página, e a mensagem de erro que a API sabe dar
	# ("/dev/hcsr04 não existe: módulo não carregado, ou container sem
	# --device") nunca chega a ser exibida. Melhor abrir a página dizendo o
	# que está errado do que não abrir nada.
	if [ -e "$DEVICE" ]; then
		QUER_DEVICE=sim
		ARGS_DEVICE="--device $DEVICE:$DEVICE"
	else
		QUER_DEVICE=nao
		ARGS_DEVICE=""
		echo "[TP] AVISO: $DEVICE não existe — subindo o container SEM o sensor."
		echo "[TP] o dashboard abre e mostra o erro de leitura."
		echo "[TP] confira: lsmod | grep hcsr04 ; dmesg | grep -i hcsr04"
	fi

	echo "[TP] aguardando Docker..."
	i=0
	while ! docker info >/dev/null 2>&1; do
		i=$((i + 1))
		if [ "$i" -ge "$TENTATIVAS" ]; then
			echo "[TP] Docker não ficou disponível em 60s."
			return 1
		fi
		sleep "$INTERVALO"
	done

	if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
		echo "[TP] carregando imagem Docker de $TAR (1º boot, pode demorar)..."
		docker load -i "$TAR" || return 1
	fi

	# Um container criado por uma imagem anterior sobrevive em /var/lib/docker e
	# seria reaproveitado com as opções ANTIGAS. Reaproveitar só serve se o que
	# ele tem bate com o que queremos agora: um container com --device não
	# inicia se o device sumiu, e um sem --device nunca enxergaria o sensor.
	if docker container inspect "$CONTAINER" >/dev/null 2>&1; then
		TEM_DEVICE="$(docker container inspect "$CONTAINER" \
			--format '{{range .HostConfig.Devices}}{{.PathInContainer}} {{end}}' 2>/dev/null)"
		case "$TEM_DEVICE" in
			*"$DEVICE"*) ATUAL=sim ;;
			*)           ATUAL=nao ;;
		esac
		if [ "$ATUAL" = "$QUER_DEVICE" ]; then
			echo "[TP] iniciando container existente $CONTAINER"
			docker start "$CONTAINER" >/dev/null
			return $?
		fi
		echo "[TP] container existente não casa com o estado do sensor: recriando"
		docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
	fi

	criar_container || return 1

	# Conferir que o container REALMENTE ficou de pé, e não só que o "docker
	# run" voltou zero. Uma imagem quebrada — por exemplo um "docker load"
	# interrompido num boot anterior, que deixa a tag existindo com camadas
	# incompletas — faz o container entrar em laço de reinício, e o S99 nunca
	# saberia. Como a tag nunca muda, o load do boot seguinte seria pulado e a
	# imagem quebrada ficaria para sempre.
	container_de_pe && return 0

	echo "[TP] o container não ficou de pé; recarregando a imagem do $TAR"
	docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
	docker rmi -f "$IMAGE" >/dev/null 2>&1 || true
	docker load -i "$TAR" || return 1
	criar_container || return 1

	container_de_pe && return 0
	echo "[TP] continua caindo. Veja: docker logs $CONTAINER"
	return 1
}

criar_container() {
	echo "[TP] criando container $CONTAINER na porta $PORTA"
	# shellcheck disable=SC2086  # ARGS_DEVICE precisa ser dividido em palavras
	docker run -d \
		--name "$CONTAINER" \
		--restart unless-stopped \
		$ARGS_DEVICE \
		-p "$PORTA:5000" \
		"$IMAGE" >/dev/null
}

container_de_pe() {
	i=0
	while [ "$i" -lt 25 ]; do
		docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$CONTAINER" && return 0
		i=$((i + 1))
		sleep "$INTERVALO"
	done
	return 1
}

stop_app() {
	docker stop "$CONTAINER" >/dev/null 2>&1 || true
}

case "$1" in
	start)
		start_app
		;;
	stop)
		stop_app
		;;
	restart)
		stop_app
		start_app
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
