#!/bin/sh
#
# S99flask-tp — sobe o container Flask do TP no boot.
#
# A aplicação deixou de ser o "hello world" do TP 8 e passou a ser o dashboard
# da distância, então a imagem e o container chamam-se tp-distance. O arquivo
# ainda se chama S99flask-tp: renomeá-lo para S99tp-app, acrescentar o
# --device /dev/hcsr04 e publicar na porta 80 são a etapa 10.
#
# Quem executa: o init do BusyBox (/etc/init.d/rcS) roda os scripts Sxx em
# ordem alfabética com "start". S60dockerd (instalado pelo pacote
# docker-engine) inicia o dockerd antes; este S99 espera o daemon responder,
# carrega a imagem do tar embutido no rootfs (só no 1º boot — depois ela fica
# em /var/lib/docker) e cria/inicia o container publicando a porta 5000.
#
# Baseado no guia da Aula 10 (Etapa 9.2).

IMAGE="tp-distance:1.0"
CONTAINER="tp-distance"
TAR="/opt/docker/tp-distance.tar"
TIMEOUT=60

start_app() {
	echo "[TP] aguardando Docker..."
	i=0
	while ! docker info >/dev/null 2>&1; do
		i=$((i + 1))
		if [ "$i" -ge "$TIMEOUT" ]; then
			echo "[TP] Docker não ficou disponível em ${TIMEOUT}s."
			return 1
		fi
		sleep 1
	done

	if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
		echo "[TP] carregando imagem Docker de $TAR (1º boot, pode demorar)..."
		docker load -i "$TAR" || return 1
	fi

	if docker container inspect "$CONTAINER" >/dev/null 2>&1; then
		echo "[TP] iniciando container existente $CONTAINER"
		docker start "$CONTAINER" >/dev/null
	else
		echo "[TP] criando container $CONTAINER na porta 5000"
		docker run -d \
			--name "$CONTAINER" \
			--restart unless-stopped \
			-p 5000:5000 \
			"$IMAGE" >/dev/null
	fi
}

stop_app() {
	docker stop "$CONTAINER" >/dev/null 2>&1 || true
}

case "$1" in
	start)
		start_app
		;;
	stop)
		stop_app
		;;
	restart)
		stop_app
		start_app
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
