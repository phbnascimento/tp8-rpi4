# =====================================================================
#  tp8.env — ÚNICO arquivo que o grupo precisa editar antes do build
# =====================================================================
#  Depois de editar, rode:  ./scripts/02-configure.sh
#  (ele regenera /etc/issue, users_table.txt e a defconfig a partir daqui)
#
#  Regras: sem espaços em HOSTNAME / USUARIO / SENHA.
#  Pode editar no Bloco de Notas do Windows — os scripts limpam o CRLF.
# =====================================================================

# Identificação do grupo (aparece no banner de login)
GRUPO="G03"

# Integrantes — um por linha, no formato "Nome Completo - RA"
INTEGRANTES=(
  "Pedro Cretella - RA 226013"
  "Pedro Brito - RA 226146"
  "Vinícius Regis - RA 230610"
  "Rafael Lima - RA 226326"
)

# Hostname da Raspberry (letras minúsculas, números e hífen)
HOSTNAME_RPI="rpi4-tp8-g03"

# Usuário de login do projeto (entra no grupo docker automaticamente)
USUARIO="aluno"

# Senha do usuário acima. NÃO use senha pessoal — ela fica no repositório.
# Use só letras minúsculas e números: o console da Pi usa layout de teclado
# americano, então símbolos (ç, @, /, ?) saem trocados num teclado ABNT2.
SENHA="tp8grupo03"

# Senha do root. Vazio = root sem senha (padrão da defconfig da Pi).
# Recomendado definir uma.
ROOT_SENHA="root00tp8"

# Versão do Buildroot (guia da Aula 10). Os slides das Aulas 8/9 citam
# 2026.05.1 como versão "congelada" — só troque se o professor pedir.
BUILDROOT_VERSION="2026.08.1"
